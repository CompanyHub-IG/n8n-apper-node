{
  "name": "n8n-nodes-apper",
  "version": "0.1.3",
  "release-it": {
    "git": {
      "requireBranch": "master"
    }
  },
  "description": "Apper is an AI app builder that turns your prompts into fully functional apps in minutes—with built-in billing, auth, and database. That means you can charge customers and manage users from day one, no code needed.",
  "main": "dist/index.js",
  "author": {
    "name": "CompanyHub-IG",
    "email": "support@companyhub.ig"
  },
  "homepage": "https://apper.io",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CompanyHub-IG/n8n-apper-node.git"
  },
  "keywords": [
    "n8n-community-node-package",
    "apper",
    "automation"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/ApperApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Apper/Apper.node.js",
      "dist/nodes/ApperTrigger/ApperTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "n8n-node": "^1.0.0",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "allowScripts": {
    "cpu-features@0.0.10": true,
    "eslint-plugin-n8n-nodes-base@1.16.7": true,
    "isolated-vm@7.0.1": true,
    "ssh2@1.15.0": true,
    "unrs-resolver@1.12.2": true
  }
}
